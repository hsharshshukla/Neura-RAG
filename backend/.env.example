APP_ENV=dev
DATABASE_URL=postgresql+psycopg://neura:replace-me@127.0.0.1:5432/neura
ALEMBIC_URL=postgresql+psycopg://neura_migrator:replace-me@127.0.0.1:5432/neura

# Required in every environment. Generate a unique value; no source fallback exists.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALG=HS256
JWT_ISSUER=neura
JWT_AUDIENCE=neura-web
JWT_EXPIRES_SECONDS=3600
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Enable only behind a proxy that overwrites forwarded client-IP headers.
TRUST_PROXY_HEADERS=false

# Set to tkp for the secured staging bridge. This disables startup of the legacy
# organizational vector index. Personal-document RAG remains a separate deferred decision.
ORGANIZATIONAL_RAG_MODE=tkp

# Internal server-to-server endpoint; never expose this URL or token to the browser.
TKP_INTERNAL_URL=http://127.0.0.1:8001
TKP_SERVICE_TOKEN=replace-with-the-read-only-tkp-service-token
TKP_STAGING_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
TKP_STAGING_WORKSPACE_NAME=TKP staging
TKP_ENVIRONMENT=dev
TKP_CONNECT_TIMEOUT_SECONDS=2
TKP_READ_TIMEOUT_SECONDS=8
TKP_TOTAL_DEADLINE_SECONDS=10
TKP_MAX_ATTEMPTS=2
TKP_CHAT_RETRIEVAL_LIMIT=10
GROUNDED_ANSWER_LLM_TIMEOUT_SECONDS=45
CONVERSATION_CONTEXT_LLM_TIMEOUT_SECONDS=20
TKP_CHAT_HISTORY_MAX_MESSAGES=12
TKP_CHAT_HISTORY_MAX_TOKENS=1200
TKP_CHAT_HISTORY_MAX_MESSAGE_CHARACTERS=2000

# Development-only fallback. Staging/production reject memory:// and require a
# shared redis:// or rediss:// service.
REDIS_URL=memory://
