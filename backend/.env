OPENAI_API_KEY=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
DATABASE_URL=sqlite:///./chatbot.db
OPENAI_MODEL=gpt-4o-mini


# Storage backend: "local" (default) or "s3"
STORAGE_BACKEND=local

# Local filesystem root (absolute path recommended)
DOC_STORAGE_PATH=./uploads

# S3/MinIO (used only if STORAGE_BACKEND=s3)
S3_BUCKET=your-bucket
S3_REGION=us-east-1
S3_ENDPOINT_URL=                    # optional (set for MinIO, e.g. http://127.0.0.1:9000)
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
S3_FORCE_PATH_STYLE=true            # set true for MinIO

# Frontend origin (used for redirects)
FRONTEND_URL=http://127.0.0.1:3000

# Your existing JWT secret/issuer as-is
JWT_SECRET=replace_me
JWT_ALG=HS256
JWT_EXPIRES_SECONDS=2592000

# Google OAuth (create on console.cloud.google.com)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Apple (Sign in with Apple — Services ID flow)
APPLE_TEAM_ID=ABCD1234
APPLE_KEY_ID=ABCD123456
APPLE_CLIENT_ID=com.your.bundle.id       # your Services ID / client_id
APPLE_PRIVATE_KEY_PATH=./AuthKey_ABCD123456.p8
APPLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/apple/callback


export TOS_VERSION=2025-08-01
export PRIVACY_VERSION=2025-08-01

STRICT_OPENTEXT_SCOPE=true
NEURA_ANSWER_POLICY=opentext_or_context   # or: context_only

# Email (dev logs only — no SMTP needed while testing)
DEV_EMAIL_LOG_ONLY=true
FROM_EMAIL=no-reply@neura.app

# If sending real mail later:
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your_user
# SMTP_PASS=your_pass

COOKIE_DOMAIN=



ACCESS_COOKIE_NAME=access_token
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
FRONTEND_URL=http://127.0.0.1:3000

FREE_DAILY_CHATS=20
MINI_DAILY_CHATS=-1
PRO_DAILY_CHATS=-1
MODEL_FREE=gpt-4o-mini
MODEL_MINI=gpt-4o-mini
MODEL_PRO=gpt-4o
